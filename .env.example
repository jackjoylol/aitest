# ── Minds (Builder API) ─────────────────────────────────────────────
# Create a Mind at hellominds.ai/profile, then create a Builder API key
# in the Builder console. See docs/MIND_SETUP.md for step-by-step.
MINDS_BUILDER_API_KEY=
# Your Mind's UUID (from `minds list` / the console). If empty, the app
# auto-selects the first Mind on the account at startup.
MIND_ID=

# ── Hearthkeeper ────────────────────────────────────────────────────
# Name of your community — used in every prompt so the Mind keeps
# context of whose house it is keeping.
HEARTHKEEPER_COMMUNITY=Pinewood Forest

# Conversation alias bound to the Mind. Stable alias = persistent,
# cross-session conversation + Soul memory. Keep it fixed.
HEARTHKEEPER_ALIAS=hearthkeeper-main

# 1 = run against a built-in simulated moderator (no Minds account
# needed; every UI label shows a MOCK badge). 0/empty = real Minds.
HEARTHKEEPER_MOCK=0

# HTTP port for the dashboard
PORT=4173

# Local audit database (SQLite)
DB_PATH=./data/hearthkeeper.db

# Optional bearer token protecting POST /api/webhook
WEBHOOK_TOKEN=

# ── Discord bot (see docs/DISCORD.md) ───────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Comma-separated channel IDs to moderate; empty = ALL channels
DISCORD_CHANNEL_IDS=
# Optional: channel ID where ALL bot/Mind output goes (verdicts,
# command replies, blacklist notices). Empty = reply in the same
# channel the message came from. Create a channel (e.g. #bot-output)
# and paste its ID here.
DISCORD_OUTPUT_CHANNEL_ID=
# 1 = automatically delete messages the Mind rules "remove"
# (requires the Manage Messages permission on the bot)
DISCORD_DELETE_REMOVED=1

# ── Instant blacklist / whitelist (auto-handled dictionaries) ───────
# Terms in blacklist.txt are removed INSTANTLY on ingest (no Mind call);
# terms in whitelist.txt are allowed INSTANTLY. The Mind also files
# keywords into both automatically when it rules. Manage from Discord
# with `!blacklist` / `!whitelist`.
BLACKLIST_PATH=./blacklist.txt
WHITELIST_PATH=./whitelist.txt

# ── Review batching ─────────────────────────────────────────────────
# Max posts per review message sent to the Mind (keep small: each batch
# is one cognition turn).
REVIEW_BATCH_SIZE=8

# ── Autonomous follow-up (node-cron) ────────────────────────────────
# Auto-review the queue when pending posts reach this count…
AUTO_REVIEW_MIN_PENDING=3
# …checked on this schedule (cron). Every 15 minutes.
AUTO_REVIEW_CRON=*/15 * * * *
# Daily community-health digest (the Mind writes an autonomous report).
DIGEST_CRON=0 9 * * *
# Daily escalation review for repeat offenders (warn / restrict / ban).
ESCALATION_CRON=0 10 * * *
# How long to wait for a Mind reply, in milliseconds.
MIND_REPLY_TIMEOUT_MS=180000
